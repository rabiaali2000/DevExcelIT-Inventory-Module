@model EditProductViewModel
@{
    ViewData["Title"] = $"Edit {Model.Sku}";
}

<h1 class="h3 mb-1">Edit product</h1>
<p class="text-muted mb-3">
    Current stock: <strong>@Model.CurrentStock.ToString("N0")</strong>.
    Stock is never edited here; it changes only through stock movements.
</p>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Version" />
            <partial name="_ProductFields" model="Model" />
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

<hr class="my-4" />

<h2 class="h5">Status</h2>
@if (Model.IsActive)
{
    <p>
        Active. Deactivating hides the product from the list and blocks new stock movements.
        Nothing is deleted: its history stays, and you can reactivate it at any time.
    </p>
    <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-outline-danger">Deactivate product</button>
    </form>
}
else
{
    <p>Inactive. The product is hidden from the list and can't record stock movements.</p>
    <form asp-action="Activate" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-outline-success">Reactivate product</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
