{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Inventory.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Inventory.Web/bin/Debug/net10.0/Inventory.Web.dll",
      "cwd": "${workspaceFolder}/src/Inventory.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5299"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
